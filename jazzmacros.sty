\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{jazzmacros}
\RequirePackage{amsmath,amssymb,array}
\RequirePackage[most]{tcolorbox}
\RequirePackage{tikz}
\RequirePackage[a4paper,top=1.8cm,bottom=2cm,left=2cm,right=2cm,headheight=14pt]{geometry}
\RequirePackage{titlesec}
\AtBeginDocument{\raggedbottom}% no vertical stretching when a page breaks early

% Compact chapter heading, so the form fits on the tune's first page
\titleformat{\chapter}[hang]{\normalfont\huge\bfseries}{\thechapter}{0.6em}{}
\titlespacing*{\chapter}{0pt}{0pt}{10pt}

% Chords: \ch{ii}{-7}  \ch{V}{7}  \ch{I}{\Delta7}
\newcommand{\chsize}{}% set to \large inside the form grid
% Struts: row heights inside the form grid (empty outside it)
\newcommand{\chstrut}{}\newcommand{\melstrut}{}\newcommand{\altstrut}{}
\newcommand{\ch}[2]{{\chsize\chstrut\mathversion{bold}$\mathrm{#1}^{#2}$}}
\RequirePackage{etoolbox}\robustify{\ch}
% Alternative (secondary) changes: smaller, grey, not bold
% \alt{\ch{V}{7}/\ch{ii}{}\; \ch{ii}{-7}}
\newcommand{\altch}[2]{$\mathrm{#1}^{#2}$}
\newcommand{\alt}[1]{\leavevmode{\footnotesize\color{black!55}\altstrut\let\ch\altch #1}}
% Melody degrees: \mel{1\;2\;\flat3\;\hi{1}\;\lo{7}}
\newcommand{\hi}[1]{\dot{#1}}
\newcommand{\lo}[1]{\underset{\cdot}{#1}}
\newcommand{\mel}[1]{\melstrut$#1$}
% Function of melody notes w.r.t. the current chord: \fn{R $\flat$3 5 $\flat$7}
% Target / landing note (circled): \mel{2\;4\;6\;\tg{\hi{1}}}
\newcommand{\tg}[1]{\tikz[baseline=(n.base)]
  \node[circle,draw,inner sep=1pt](n){$#1$};}
\newcommand{\fn}[1]{{\scriptsize\textit{#1}}}
% Chords outside the key (secondary dominants, borrowed, etc.): \chx{III}{7}
\definecolor{chromatic}{rgb}{0.65,0.1,0.1}
\newcommand{\chx}[2]{\leavevmode{\color{chromatic}\ch{#1}{#2}}}
% Function label of a circled melody note over a chromatic chord:
% \mel{\tg{6}}\tfn{$\flat$7}
\newcommand{\tfn}[1]{\textsuperscript{\color{chromatic}#1}}

% Tune header
\newcommand{\tunekeys}{}
\newcounter{exercise}
% \tune{Title}{Authors}{First published}{Keys}{Form}
\newcommand{\tune}[5]{\chapter{#1}\renewcommand{\tunekeys}{#4}\setcounter{exercise}{0}%
  \noindent{\itshape #2 \textperiodcentered\ #3}\par\smallskip
  \noindent\textbf{Keys:} #4 \quad \textbf{Form:} #5\tunenotationnote\par\medskip}
% Footnote on the notation, used in the single-tune PDFs (song.tex), which have no legend
\newcommand{\tunenotationnote}{}
\newcommand{\notationfootnote}{\renewcommand{\tunenotationnote}{\footnote{Number notation:
  melody as scale degrees and chords as Roman numerals, relative to the key. The symbols
  are explained in the Notation chapter of the full Nerdbook,
  \url{https://github.com/enridaga/nerdbook}.}}}

% Tune folders: tunes/<name>/tune.tex includes its parts with \tunepart{file}
\newif\ifformsonly   % \formsonlytrue in forms.tex: print only the forms
\newcommand{\tunedir}{}
\newcommand{\tuneinclude}[1]{\clearpage\renewcommand{\tunedir}{tunes/#1}\input{tunes/#1/tune}}
\newcommand{\tunepart}[1]{\IfFileExists{\tunedir/#1.tex}{\input{\tunedir/#1}}{}}
% Tune in number notation with rhythm: tunes/<name>/tune-score.pdf, generated by make.sh
% with LilyPond from tunes/<name>/tune.ly. Section left out if the PDF is missing.
% Always on one page: starts a new page; scaled down only if taller than the page.
\RequirePackage{graphicx}
\newcommand{\tunescore}{\IfFileExists{\tunedir/tune-score.pdf}%
  {\clearpage\section{Tune}\noindent
   \includegraphics[width=\linewidth,height=\dimexpr\textheight-3\baselineskip\relax,keepaspectratio]%
     {\tunedir/tune-score.pdf}\par}{}}

% Shared exercises (folder exercises/): \exercise{all-keys}
\newcommand{\exercise}[1]{\refstepcounter{exercise}\input{exercises/#1}}
% Checkboxes for the tune's keys
\newcommand{\keyboxes}{\noindent\foreach \k in \tunekeys {$\square$~\k\quad}\par}

% Shared patterns (folder patterns/): \pattern[bars 3, 7, 19]{ii-v-i-guide-tones}
% Numbers are degrees of the key of the target chord (e.g. of I in ii-V-I).
\newcommand{\patternwhere}{}
\newcommand{\currentpattern}{}
\newcounter{patterntab}
\newcommand{\pattern}[2][]{\def\patternwhere{#1}\renewcommand{\currentpattern}{#2}%
  \setcounter{patterntab}{0}\input{patterns/#2}}
% Guitar tab of a pattern line, shown only in the pattern book (\tabstrue).
% Syntax: degrees of the key, ' = octave up, , = octave down, | = bar line,
% optional reference key: \patterntab[C]{1 2 b3 3 5 6}. Default key G.
% The tab itself is generated by tools/tabs.py into patterns/tabs/<pattern>-<n>.tex
\newif\iftabs
\newcommand{\patterntab}[2][]{\stepcounter{patterntab}\iftabs
  \par\smallskip\IfFileExists{patterns/tabs/\currentpattern-\thepatterntab.tex}
    {\input{patterns/tabs/\currentpattern-\thepatterntab}}
    {{\footnotesize[tab not generated: run make.sh]}}\par\fi}
\newcommand{\patternwhereline}{\ifx\patternwhere\empty\else
  \par\smallskip{\footnotesize\textit{In this tune:} \patternwhere}\fi}
% In the pattern book (\patternbooktrue) the box has no "Pattern:" prefix, and each
% pattern is a section in the contents, with a label for the alphabetical index.
\newif\ifpatternbook
\newcommand{\patterngroup}[1]{\chapter{#1}}
\newenvironment{patternbox}[2]
  {\ifpatternbook\phantomsection\addcontentsline{toc}{section}{#1}%
     \label{pat:\currentpattern}\def\patternboxtitle{#1}%
   \else\def\patternboxtitle{Pattern: #1}\fi
   \begin{tcolorbox}[colback=violet!3,colframe=violet!50!black,
     fonttitle=\bfseries,title={\patternboxtitle}]
   {\footnotesize\textit{Over:} #2}\par\smallskip}
  {\end{tcolorbox}}

% iReal Pro files of a tune (box generated by tunes/<name>/ireal.py)
\newenvironment{irealfiles}
  {\begin{tcolorbox}[colback=green!3,colframe=green!35!black,
     fonttitle=\bfseries,title={iReal Pro files}]
   \begin{itemize}\setlength{\itemsep}{2pt}}
  {\end{itemize}\end{tcolorbox}}
\newcommand{\irealfile}[2]{\item \texttt{ireal/#1}\\{\footnotesize #2}}

% Form grid: label + 4 bars per row
% (a tabular never breaks across pages: keep it right after \tune)
\newenvironment{form}
  {\par\noindent\renewcommand{\arraystretch}{1}\renewcommand{\chsize}{\large}%
   \renewcommand{\melstrut}{\rule[-3pt]{0pt}{15pt}}%
   \renewcommand{\chstrut}{\rule[-4pt]{0pt}{16pt}}%
   \renewcommand{\altstrut}{\rule[-4pt]{0pt}{9pt}}%
   \begin{tabular}{l|*{4}{p{\dimexpr(\linewidth-1.2cm)/4-2\tabcolsep\relax}|}}\hline}
  {\end{tabular}\par}

\newtcolorbox{study}[1]{colback=gray!5,colframe=gray!60,title={#1}}
% Credit for ideas inspired by a lesson, at the end of a study box
\newcommand{\ideasfrom}[1]{\par\smallskip{\footnotesize\itshape Some of these ideas were inspired by #1.}}
% General / historical notes: \begin{notes}...\end{notes}  (optional title)
\newtcolorbox{notes}[1][Notes]{colback=blue!3,colframe=blue!40!black,
  fonttitle=\bfseries,title={#1}}

% Reference recordings:
% \begin{recordings} \rec{Artist}{Album}{Year} ... \end{recordings}
\newenvironment{recordings}
  {\begin{tcolorbox}[colback=orange!4,colframe=orange!60!black,
     fonttitle=\bfseries,title={Reference recordings}]
   \begin{itemize}\setlength{\itemsep}{2pt}}
  {\end{itemize}\end{tcolorbox}}
\newcommand{\rec}[3]{\item \textbf{#1}, \emph{#2}\if\relax\detokenize{#3}\relax\else\ (#3)\fi}

% Bibliographic sources inside boxes:
% \sources{\src{Wikipedia}{https://...}; \src{...}{...}}
\RequirePackage[hidelinks]{hyperref}
\newcommand{\src}[2]{\href{#2}{#1}\footnote{\url{#2}}}
\newcommand{\sources}[1]{\par\smallskip{\footnotesize\textit{Sources:} #1}}

% Footer: version (from make.sh -> version.tex) and build date
\RequirePackage{fancyhdr}
\IfFileExists{version.tex}{\input{version.tex}}
  {\newcommand{\docversion}{dev}\newcommand{\docdate}{\today}}
\newcommand{\versionline}{\footnotesize\color{black!60}Nerdbook v\docversion\ \textperiodcentered\ \docdate\ \textperiodcentered\ \href{https://creativecommons.org/licenses/by-nc-nd/4.0/}{CC BY-NC-ND 4.0}}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE]{\thepage}\fancyhead[RO]{\thepage}
\fancyhead[RE]{\itshape\nouppercase{\leftmark}}
\fancyhead[LO]{\itshape\nouppercase{\rightmark}}
\fancyfoot[C]{\versionline}
\renewcommand{\headrulewidth}{0pt}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\versionline}\fancyfoot[R]{\footnotesize\thepage}}

% ---------------------------------------------------------------------------
% Cover page: \nerdcover{<volume>}, e.g. \nerdcover{Study book}
% A chromatic wheel of scale degrees (outer ring), the diatonic chords as Roman
% numerals (inner ring) and the ii--V--I path, in the book's violet.
\definecolor{nbviolet}{rgb}{0.30,0.12,0.42}
\definecolor{nbpaper}{rgb}{0.985,0.972,0.945}
\definecolor{nbgold}{rgb}{0.80,0.58,0.20}
\usetikzlibrary{arrows.meta}
\newcommand{\nerdcover}[1]{%
  \hypersetup{pdftitle={Nerdbook -- #1},pdfauthor={The Nerdbook contributors}}%
  \begin{titlepage}
  \begin{tikzpicture}[remember picture,overlay]
    \fill[nbpaper] (current page.south west) rectangle (current page.north east);
    \fill[nbviolet] (current page.north west) rectangle ([xshift=1.7cm]current page.south west);
    \node[rotate=90,text=white,font=\sffamily\footnotesize\bfseries]
      at ([xshift=.85cm,yshift=-7.5cm]current page.north west)
      {N\,U\,M\,B\,E\,R\quad N\,O\,T\,A\,T\,I\,O\,N\qquad\textperiodcentered\qquad J\,A\,Z\,Z\quad S\,T\,U\,D\,Y};
    \begin{scope}[shift={([xshift=.85cm,yshift=-10.2cm]current page.north)}]
      \draw[nbviolet!20,line width=.8pt] (0,0) circle (5.5);
      \draw[nbviolet!12,line width=.6pt] (0,0) circle (3.4);
      \foreach \k/\lab/\dia in {0/1/1,1/\flat2/0,2/2/1,3/\flat3/0,4/3/1,5/4/1,
                                6/\sharp4/0,7/5/1,8/\flat6/0,9/6/1,10/\flat7/0,11/7/1}{
        \ifnum\dia=1
          \node[circle,minimum size=1.15cm,fill=nbpaper,draw=nbviolet,line width=1pt,
                text=nbviolet,font=\LARGE] at ({90-30*\k}:5.5) {$\lab$};
        \else
          \node[circle,minimum size=.95cm,fill=nbpaper,draw=black!25,
                text=black!45,font=\large] at ({90-30*\k}:5.5) {$\lab$};
        \fi}
      \foreach \k/\r in {0/I,2/ii,4/iii,5/IV,7/V,9/vi,11/vii^{\text{\o}}}
        \node[text=black!75,font=\Large] at ({90-30*\k}:3.4) {{\boldmath$\mathrm{\r}$}};
      % ii -> V -> I
      \draw[-{Latex[length=3mm]},nbgold,line width=1.6pt]
        ({90-30*2}:2.75) to[bend left=25] ({90-30*7}:2.75);
      \draw[-{Latex[length=3mm]},nbgold,line width=1.6pt]
        ({90-30*7}:2.75) to[bend left=25] ({90}:2.75);
      \node[text=nbgold!80!black,font=\sffamily\small\bfseries] at (0,-.1) {ii\,--\,V\,--\,I};
    \end{scope}
    \node[anchor=north west,text=nbviolet,font=\sffamily\bfseries]
      at ([xshift=3cm,yshift=-18.6cm]current page.north west) {\scalebox{2.6}{\Huge Nerdbook}};
    \node[anchor=north west,text=black!70,font=\large\itshape]
      at ([xshift=3.1cm,yshift=-21.2cm]current page.north west)
      {A jazz study book in number notation};
    \draw[nbgold,line width=1.2pt]
      ([xshift=3.1cm,yshift=-22.3cm]current page.north west) -- ++(4cm,0);
    \node[anchor=north west,text=nbviolet,font=\sffamily\Large\bfseries]
      at ([xshift=3.1cm,yshift=-22.7cm]current page.north west) {\MakeUppercase{#1}};
    \node[anchor=south west,text=black!75,font=\large]
      at ([xshift=3.1cm,yshift=2.6cm]current page.south west) {The Nerdbook contributors};
    \node[anchor=south west,text=black!50,font=\footnotesize]
      at ([xshift=3.1cm,yshift=2cm]current page.south west)
      {v\docversion\ \textperiodcentered\ \docdate\ \textperiodcentered\ \textit{work in progress}};
  \end{tikzpicture}
  \end{titlepage}
  \nerdlicense}

